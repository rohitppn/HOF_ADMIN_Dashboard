# Anthropic
ANTHROPIC_API_KEY=

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Server
PORT=3001
TZ=Asia/Kolkata

# Optional: admin endpoint guard
ADMIN_SECRET=

# Owner phone numbers (comma-separated, no + or spaces). Only these can run commands / queries.
OWNERS=

# Leadership / manager group JID (rankings, alerts, owner Q&A go here).
MANAGER_GROUP_JID=

# Store group JIDs — pattern: STORE_<KEY>_JID  (KEY must match config.js entries, uppercased)
# Bot only ingests messages from these groups. Any other group is ignored.
STORE_CP_JID=
STORE_JKMALL_JID=
STORE_DLF_JID=
STORE_GIP_JID=
STORE_AMBIENCE_JID=
