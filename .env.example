# Anthropic
ANTHROPIC_API_KEY=

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=3001
TZ=Asia/Kolkata

# Random string that gates /admin/* URLs and the dashboard login.
# Generate with: openssl rand -hex 24
ADMIN_SECRET=

# Owner phone numbers (comma-separated, no + or spaces). Only these can run commands / queries.
OWNERS=

# The single WhatsApp group where all store managers post updates.
# Get the JID from the dashboard's WhatsApp tab after linking.
MAIN_GROUP_JID=

# Optional — separate leadership group for rankings/alerts/Q&A.
# If blank, defaults to MAIN_GROUP_JID.
MANAGER_GROUP_JID=

# Comma-separated list of origins allowed to hit /dashboard-api/*.
# Leave empty for same-origin only (Railway single-URL deploy).
# For GitHub Pages: ALLOWED_ORIGINS=https://<username>.github.io
ALLOWED_ORIGINS=
